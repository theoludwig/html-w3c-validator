{
  "root": true,
  "extends": ["conventions"],
  "plugins": ["promise", "unicorn"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parser": "@typescript-eslint/parser",
      "plugins": ["@typescript-eslint"],
      "parserOptions": {
        "projectService": true
      },
      "rules": {
        "@typescript-eslint/no-unnecessary-condition": "off"
      }
    }
  ]
}
